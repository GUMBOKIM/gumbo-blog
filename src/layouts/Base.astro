---
import { ClientRouter } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';
import { GOOGLE_VERIFICATION, NAVER_VERIFICATION } from '../consts';
import { AUTHOR, DEFAULT_LOCALE, SITE_TITLE, ui, localize, otherLocale, switchLocale, type Locale } from '../i18n';

interface Props {
	locale: Locale;
	title?: string;
	description?: string;
	/** Path of this page in the other locale, when it differs from the default mapping */
	alternate?: string;
	/** Set on post pages so search engines get the article's date and author */
	published?: Date;
}

const { locale, title, description = ui[locale].description, published } = Astro.props;
const other = otherLocale(locale);
const alternate = Astro.props.alternate ?? switchLocale(Astro.url.pathname, other);
const aboutPath = localize(locale, '/about');
const postsPath = localize(locale, '/posts');
const current = Astro.url.pathname.replace(/(?<=.)\/$/, '');
const isAbout = current === aboutPath;
const isPosts = current === postsPath || current.startsWith(`${postsPath}/`);
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const author = { '@type': 'Person', name: AUTHOR, url: new URL(localize(locale, '/about'), Astro.site).href };
const jsonLd = published
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description,
			datePublished: published.toISOString().slice(0, 10),
			inLanguage: locale,
			mainEntityOfPage: canonical.href,
			author,
		}
	: {
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: SITE_TITLE,
			description,
			inLanguage: locale,
			url: new URL(localize(locale, '/'), Astro.site).href,
			author,
		};
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang={locale} href={canonical} />
		<link rel="alternate" hreflang={other} href={new URL(alternate, Astro.site)} />
		<link
			rel="alternate"
			hreflang="x-default"
			href={locale === DEFAULT_LOCALE ? canonical : new URL(alternate, Astro.site)}
		/>
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={localize(locale, '/rss.xml')} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={published ? 'article' : 'website'} />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
		{/* Ownership checks for Google Search Console and Naver Search Advisor */}
		{GOOGLE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_VERIFICATION} />}
		{NAVER_VERIFICATION && <meta name="naver-site-verification" content={NAVER_VERIFICATION} />}
		<Analytics />
		<ClientRouter />
	</head>
	<body>
		<main class="w">
			<header class="site-header">
				<nav class="menu">
					<a href={localize(locale, '/')} class="logo">{SITE_TITLE}</a>
					<a href={aboutPath} data-label="about" aria-current={isAbout ? 'page' : undefined}>about</a>
					<a href={postsPath} data-label="posts" aria-current={isPosts ? 'page' : undefined}>posts</a>
				</nav>
				<nav class="lang">
					<a href={alternate} lang={other}>{ui[locale].other}</a>
				</nav>
			</header>
			<slot />
		</main>
		<footer>
			<span>© {new Date().getFullYear()} {SITE_TITLE}</span>
			<a href={localize(locale, '/rss.xml')}>rss</a>
		</footer>
		<dialog class="lightbox" aria-label="Enlarged image"><img alt="" /></dialog>
		<script>
			// Click any photo in the about page or a post to view it full size; click again to close.
			// Runs on every client-side navigation since ClientRouter swaps the page content.
			document.addEventListener('astro:page-load', () => {
				const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
				const big = dialog?.querySelector('img');
				if (!dialog || !big) return;
				dialog.onclick = () => dialog.close();
				for (const img of document.querySelectorAll<HTMLImageElement>('.about img:not(.logo), article img:not(.diagram)')) {
					img.onclick = () => {
						big.src = img.currentSrc || img.src;
						big.alt = img.alt;
						dialog.showModal();
					};
				}
			});
		</script>
	</body>
</html>
