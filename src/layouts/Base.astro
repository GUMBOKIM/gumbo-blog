---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { SITE_TITLE, ui, localize, otherLocale, switchLocale, type Locale } from '../i18n';

interface Props {
	locale: Locale;
	title?: string;
	description?: string;
	/** Path of this page in the other locale, when it differs from the default mapping */
	alternate?: string;
}

const { locale, title, description = ui[locale].description } = Astro.props;
const other = otherLocale(locale);
const alternate = Astro.props.alternate ?? switchLocale(Astro.url.pathname, other);
const aboutPath = localize(locale, '/about');
const postsPath = localize(locale, '/posts');
const current = Astro.url.pathname.replace(/(?<=.)\/$/, '');
const isAbout = current === aboutPath;
const isPosts = current === postsPath || current.startsWith(`${postsPath}/`);
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang={other} href={new URL(alternate, Astro.site)} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<ClientRouter />
	</head>
	<body>
		<main class="w">
			<header class="site-header">
				<nav class="menu">
					<a href={localize(locale, '/')} class="logo">{SITE_TITLE}</a>
					<a href={aboutPath} data-label="about" aria-current={isAbout ? 'page' : undefined}>about</a>
					<a href={postsPath} data-label="posts" aria-current={isPosts ? 'page' : undefined}>posts</a>
				</nav>
				<nav class="lang">
					<a href={alternate} lang={other}>{ui[locale].other}</a>
				</nav>
			</header>
			<slot />
		</main>
		<footer>
			© {new Date().getFullYear()} {SITE_TITLE}
		</footer>
		<dialog class="lightbox" aria-label="Enlarged image"><img alt="" /></dialog>
		<script>
			// Click any photo in the about page or a post to view it full size; click again to close.
			// Runs on every client-side navigation since ClientRouter swaps the page content.
			document.addEventListener('astro:page-load', () => {
				const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
				const big = dialog?.querySelector('img');
				if (!dialog || !big) return;
				dialog.onclick = () => dialog.close();
				for (const img of document.querySelectorAll<HTMLImageElement>('.about img:not(.logo), article img')) {
					img.onclick = () => {
						big.src = img.currentSrc || img.src;
						big.alt = img.alt;
						dialog.showModal();
					};
				}
			});
		</script>
	</body>
</html>
