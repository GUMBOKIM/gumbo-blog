---
/**
 * Talking piano: famous movie lines (shipped as keygrams only) and the reader's own voice,
 * played back as piano chords with a piano roll and optional subtitles.
 */
import type { Locale } from '../../i18n';
import { CLIPS } from './clips';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

const strings = {
	ko: {
		play: '피아노로 듣기',
		voice: '원래 목소리',
		record: '내 목소리',
		subs: '자막',
		subsHidden: '자막이 꺼져 있습니다',
		fps: '초당 타건',
		voices: '건반 수',
		source: '출처',
		micLine: '방금 한 말',
		micReady: '녹음한 목소리',
		micRecording: '녹음 중 {s}초 · 다시 누르면 멈춥니다',
		micWorking: '분석 중…',
		micFail: '마이크를 열 수 없습니다',
		label: '피아노 롤',
	},
	en: {
		play: 'Play on piano',
		voice: 'Original voice',
		record: 'My voice',
		subs: 'Subtitles',
		subsHidden: 'Subtitles are off',
		fps: 'Chords/s',
		voices: 'Keys',
		source: 'Source',
		micLine: 'What you just said',
		micReady: 'Your recording',
		micRecording: 'Recording {s}s · press again to stop',
		micWorking: 'Analysing…',
		micFail: 'Could not open the microphone',
		label: 'Piano roll',
	},
}[locale];
---

<div
	class="talking-piano"
	data-talking-piano
	data-locale={locale}
	data-mic-line={strings.micLine}
	data-mic-ready={strings.micReady}
	data-mic-recording={strings.micRecording}
	data-mic-working={strings.micWorking}
	data-mic-fail={strings.micFail}
>
	<div class="bar clips" role="group">
		{
			CLIPS.map((clip, i) => (
				<button type="button" data-clip={clip.id} aria-pressed={i === 0 ? 'true' : 'false'}>
					{clip.who[locale].split(' · ')[0]}
				</button>
			))
		}
		<button type="button" class="record" data-record aria-pressed="false">
			<span class="dot" aria-hidden="true"></span>{strings.record}
		</button>
	</div>

	<canvas aria-label={strings.label}></canvas>

	<div class="subs">
		<p class="line" data-line></p>
		<p class="gloss" data-gloss></p>
		<p class="hidden-note">{strings.subsHidden}</p>
	</div>

	<div class="bar">
		<button type="button" class="play" data-play aria-pressed="false">
			<span class="icon" aria-hidden="true"></span>{strings.play}
		</button>
		<button type="button" data-voice aria-pressed="false" hidden>{strings.voice}</button>
		<button type="button" data-subs aria-pressed="false">{strings.subs}</button>
		<a class="source" data-source target="_blank" rel="noopener">{strings.source}</a>
	</div>

	<div class="bar sliders">
		<label>
			<span>{strings.fps}</span>
			<input type="range" min="4" max="40" step="1" value="16" data-fps />
			<output data-fps-out>16</output>
		</label>
		<label>
			<span>{strings.voices}</span>
			<input type="range" min="1" max="40" step="1" value="24" data-voices />
			<output data-voices-out>24</output>
		</label>
	</div>

	<p class="status" data-status></p>
</div>

<script>
	import { mountAll, unmountAll } from './widget';
	// ClientRouter swaps page content without reloading this module, so (re)mount on every
	// page load and release the microphone and audio before the page goes away.
	document.addEventListener('astro:page-load', mountAll);
	document.addEventListener('astro:before-swap', unmountAll);
</script>

<style>
	.talking-piano {
		margin: 2em 0;
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	canvas {
		display: block;
		width: 100%;
		height: 240px;
		background: #0c0c0c;
		border-radius: 6px;
	}

	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4em 0.5em;
		margin: 0.6em 0;
	}

	[hidden] {
		display: none !important;
	}

	button {
		padding: 0.35em 0.8em;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--bg-secondary);
		color: var(--text);
		font: inherit;
		line-height: 1.4;
		white-space: nowrap;
		cursor: pointer;
	}

	button:hover {
		border-color: var(--text-secondary);
	}

	button[aria-pressed='true'] {
		border-color: var(--accent);
		color: var(--accent);
	}

	.record .dot {
		display: inline-block;
		width: 0.6em;
		height: 0.6em;
		margin-right: 0.45em;
		border-radius: 50%;
		background: oklch(65% 0.2 25);
		vertical-align: 0.05em;
	}

	.record.recording .dot {
		animation: blink 0.8s steps(2, jump-none) infinite;
	}

	@keyframes blink {
		to {
			opacity: 0.2;
		}
	}

	/* Play / stop glyph drawn in CSS so the label width never changes */
	.play .icon {
		display: inline-block;
		width: 0;
		height: 0;
		margin-right: 0.5em;
		border-style: solid;
		border-width: 0.32em 0 0.32em 0.55em;
		border-color: transparent transparent transparent currentColor;
		vertical-align: 0.02em;
	}

	.play[aria-pressed='true'] .icon {
		width: 0.6em;
		height: 0.6em;
		border: 0;
		background: currentColor;
	}

	.source {
		margin-left: auto;
		color: var(--text-secondary);
		font-size: 0.78rem;
	}

	/* Fixed height so toggling subtitles or switching clips doesn't move the controls */
	.subs {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 4.6em;
		margin: 0.6em 0 0;
		text-align: center;
	}

	.subs p {
		margin: 0;
	}

	.line {
		color: var(--headings);
		font-family: var(--font-sans);
		font-size: 1.35rem;
		font-weight: 700;
		line-height: 1.4;
	}

	.line :global(span) {
		transition: opacity 0.08s;
	}

	.line :global(span.ahead) {
		opacity: 0.2;
	}

	.gloss {
		margin-top: 0.2em !important;
		color: var(--text-secondary);
		font-family: var(--font-sans);
		font-size: 0.85rem;
	}

	.hidden-note {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-secondary);
		font-size: 0.78rem;
	}

	.talking-piano:not(.subs-on) .line,
	.talking-piano:not(.subs-on) .gloss {
		visibility: hidden;
	}

	.talking-piano.subs-on .hidden-note {
		display: none;
	}

	.sliders label {
		display: flex;
		flex: 1 1 14em;
		align-items: center;
		gap: 0.6em;
		color: var(--text-secondary);
	}

	.sliders span {
		flex: none;
		min-width: 5.5em;
	}

	.sliders input {
		flex: 1;
		min-width: 0;
		accent-color: var(--accent);
	}

	.sliders output {
		flex: none;
		width: 2ch;
		color: var(--text);
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.status {
		min-height: 1.6em;
		margin: 0.2em 0 0;
		color: var(--text-secondary);
		font-size: 0.78rem;
	}

	@media (max-width: 600px) {
		canvas {
			width: calc(100% + var(--gutter) * 2);
			margin-left: calc(var(--gutter) * -1);
			border-radius: 0;
		}
	}
</style>
