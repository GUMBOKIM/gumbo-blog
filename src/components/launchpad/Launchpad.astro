---
import { launchpadUi, type Locale } from '../../i18n';
import samples from '../../content/blog/launchpad/assets/samples.json';
const { locale = 'ko' } = Astro.props as { locale?: Locale };
const t = launchpadUi[locale];
const audio = import.meta.glob('../../content/blog/launchpad/assets/*.mp3', { eager: true, query: '?url', import: 'default' }) as Record<string, string>;
---
<section class="launchpad" data-launchpad data-bass={audio['../../content/blog/launchpad/assets/bass-loop.mp3']} data-strings={JSON.stringify(t)} aria-label={t.title}>
  <header class="display"><div><small>FINGER DRUMMING / 12 PADS</small><strong>TOKYO DRIFT</strong></div><output data-now>{t.idle}</output></header>
  <div class="transport">
    <button type="button" data-demo aria-pressed="false">▶ {t.demo}</button>
    <button type="button" data-beat aria-pressed="false">↻ {t.beat}</button>
    <button type="button" data-stop>■ {t.stop}</button>
  </div>
  <p class="section" data-section aria-live="off">{t.freeplay}</p>
  <div class="steps" aria-hidden="true">{Array.from({length:16},(_,i)=><i data-step={i}></i>)}</div>
  <div class="legend"><span>{t.lead} / QWER</span><span>{t.drums} / ASDF</span><span>{t.vocal} / ZXCV</span></div>
  <div class="pads">
    {samples.map(sample => <button type="button" class="pad" data-group={sample.group} data-code={`Key${sample.key}`} data-url={audio[`../../content/blog/launchpad/assets/${sample.key}.mp3`]} data-label={sample.label} aria-label={`${sample.key}: ${sample.label}`}><kbd>{sample.key}</kbd><span>{sample.label}</span><i aria-hidden="true"></i></button>)}
  </div>
  <div class="controls">
    <label>{t.tempo}<input data-tempo type="range" min="80" max="160" value="127" /><output data-tempo-out>127</output><small>BPM</small></label>
    <label>{t.volume}<input data-volume type="range" min="0" max="100" value="65" /></label>
  </div>
  <div class="practice"><span>{t.pattern}</span><code>Q · Q · Q · Q · Q W E Q · Q</code></div>
  <p class="status" data-status role="status">{t.hint}</p>
  <button class="load" type="button" data-start>{t.start}</button>
  <noscript>{t.noScript}</noscript>
</section>
<script>
  import { mount, unmount } from './widget';
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
</script>
<style>
.launchpad { margin:2rem 0; padding:clamp(14px,3vw,26px); border:1px solid var(--border); border-radius:18px; background:var(--bg); box-shadow:inset 0 1px 0 var(--border),0 14px 40px #0004; font-family:var(--font-mono); }
.display { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:22px; }
.display small { display:block; color:var(--text-secondary); font-size:.6rem; letter-spacing:.1em; }
.display strong { display:block; margin-top:5px; font-size:clamp(1.1rem,4vw,1.6rem); letter-spacing:.04em; }
.display output { max-width:40%; color:var(--accent); font-size:.68rem; text-align:right; }
button { font:inherit; color:var(--text); cursor:pointer; border:1px solid var(--border); background:var(--bg-secondary); border-radius:6px; }
.transport { display:flex; flex-wrap:wrap; gap:8px; }
.transport button { flex:1; padding:10px 8px; font-size:.75rem; white-space:nowrap; }
.transport button[aria-pressed='true'] { color:var(--bg); background:var(--accent); border-color:var(--accent); }
.section { color:var(--text-secondary); font-size:.7rem; min-height:1.5em; margin:14px 0 0; }
.steps { display:grid; grid-template-columns:repeat(16,1fr); gap:5px; margin:18px 0; }
.steps i { height:5px; border-radius:2px; background:var(--border); }
.steps i:nth-child(4n+1) { background:var(--text-secondary); }
.steps i.on { background:var(--accent); box-shadow:0 0 8px var(--accent); }
.legend { display:flex; flex-wrap:wrap; gap:8px 16px; margin-bottom:10px; font-size:.62rem; }
.legend span:nth-child(1) { color:var(--pad-lead); }.legend span:nth-child(2) { color:var(--pad-drum); }.legend span:nth-child(3) { color:var(--pad-vocal); }
.pads { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:clamp(7px,2vw,13px); }
.pad { --pad:var(--pad-lead); aspect-ratio:1; position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:8px; touch-action:manipulation; user-select:none; -webkit-user-select:none; border:1px solid color-mix(in srgb,var(--pad) 65%,var(--bg)); border-radius:9px; background:color-mix(in srgb,var(--pad) 16%,var(--bg)); box-shadow:inset 0 0 20px color-mix(in srgb,var(--pad) 10%,transparent),0 4px 0 color-mix(in srgb,var(--pad) 30%,var(--bg)); color:var(--pad); }
.pad[data-group='drum'] { --pad:var(--pad-drum); }.pad[data-group='vocal'] { --pad:var(--pad-vocal); }
.pad kbd { font:inherit; font-size:clamp(1.3rem,5vw,2rem); font-weight:700; }
.pad span { font-size:clamp(.57rem,1.8vw,.75rem); line-height:1.2; }
.pad i { position:absolute; top:7px; right:7px; width:4px; height:4px; border-radius:50%; background:var(--pad); opacity:.55; }
.pad:hover { border-color:var(--pad); }
.pad.active { background:var(--pad); color:var(--bg); box-shadow:0 0 22px color-mix(in srgb,var(--pad) 55%,transparent),inset 0 0 12px #fff8; transform:translateY(2px); }
.pad.active i { background:var(--bg); }
button:focus-visible,input:focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
.controls { display:flex; flex-wrap:wrap; gap:16px; margin-top:24px; font-size:.7rem; }
.controls label { display:flex; align-items:center; flex:1 1 190px; gap:8px; }
.controls input { min-width:40px; width:70px; flex:1; accent-color:var(--accent); }
.controls output { min-width:3ch; font-variant-numeric:tabular-nums; }.controls small { font-size:.6rem; color:var(--text-secondary); }
.practice { padding:14px 0; margin-top:16px; border-top:1px solid var(--border); }.practice span { display:block; color:var(--text-secondary); font-size:.65rem; }.practice code { display:block; background:none; padding:8px 0 0; font-size:clamp(.65rem,2.4vw,.9rem); color:var(--pad-lead); white-space:normal; }
.status { min-height:3em; margin:0; font-size:.7rem; color:var(--text-secondary); }
.load { padding:5px 9px; margin-top:8px; font-size:.65rem; }.load:disabled { opacity:.5; cursor:default; }
@media(prefers-reduced-motion:reduce) { .pad.active { transform:none; box-shadow:none; }.steps i.on { box-shadow:none; } }
</style>
