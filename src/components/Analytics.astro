---
// Google Analytics 4. Set PUBLIC_GA_ID in .env (or the GitHub Actions env) to switch it on;
// with no id nothing is loaded, so local development stays untracked.
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{
	gaId && (
		<>
			<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
			<script is:inline define:vars={{ gaId }}>
				// ClientRouter can re-run this inline script on navigation, and a second config call sends
				// its own page_view and doubles every later one, so set GA up only once per full load
				if (!window.gaReady) {
					window.gaReady = true;
					window.dataLayer = window.dataLayer || [];
					function gtag() {
						dataLayer.push(arguments);
					}
					gtag('js', new Date());
					// config sends the first page view, and GA4 enhanced measurement ("page changes based on
					// browser history events") picks up ClientRouter navigations, so no manual page_view here
					gtag('config', gaId);
				}
			</script>
		</>
	)
}
