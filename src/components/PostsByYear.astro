---
import type { CollectionEntry } from 'astro:content';
import { groupByYear, localize, postSlug, shortDate, ui, type Locale } from '../i18n';

interface Props {
	locale: Locale;
	posts: CollectionEntry<'blog'>[];
}

const { locale, posts } = Astro.props;
const t = ui[locale];
---

{
	groupByYear(posts).map(([year, posts]) => (
		<section class="entries">
			<h2>{year}</h2>
			<ul>
				{posts.map((post) => (
					<li>
						<a href={localize(locale, `/posts/${postSlug(post)}/`)}>
							<span class="meta">
								<time datetime={post.data.date.toISOString()}>{shortDate(post.data.date).replace('-', '.')}</time>
								<span class="tag">{t[post.data.category]}</span>
							</span>
							<span class="title">{post.data.title}</span>
							{post.data.description && <span class="summary">{post.data.description}</span>}
						</a>
					</li>
				))}
			</ul>
		</section>
	))
}
