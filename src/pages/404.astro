---
import Base from '../layouts/Base.astro';
import { DEFAULT_LOCALE } from '../i18n';
---

{/* GitHub Pages serves this one file for every missing URL, so it carries both languages */}
<Base locale={DEFAULT_LOCALE} title="404">
	<section class="notfound">
		<h1>404</h1>
		<p>없는 페이지예요. 주소가 바뀌었거나 글이 지워졌을 수 있어요.</p>
		<p lang="en">This page doesn't exist. The address may have changed, or the post may have been removed.</p>
		<p class="more">
			<a href="/posts">글 목록으로 →</a>
			<a href="/en/posts">All posts →</a>
		</p>
	</section>
</Base>
