---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Comments from '../../../components/Comments.astro';
import { LOCALES, formatDate, getPosts, localeParam, localize, otherLocale, postSlug, ui } from '../../../i18n';

export async function getStaticPaths() {
	const slugsByLocale = new Map<string, Set<string>>();
	const entries = await Promise.all(LOCALES.map(async (locale) => ({ locale, posts: await getPosts(locale) })));
	for (const { locale, posts } of entries) slugsByLocale.set(locale, new Set(posts.map(postSlug)));

	return entries.flatMap(({ locale, posts }) => {
		const other = otherLocale(locale);
		// posts are newest first, so the next post to read is the one before it in the list
		return posts.map((post, i) => {
			const slug = postSlug(post);
			// Fall back to the other locale's home when no translation exists
			const alternate = localize(other, slugsByLocale.get(other)!.has(slug) ? `/posts/${slug}/` : '/');
			return {
				params: { locale: localeParam(locale), slug },
				props: { locale, post, alternate, newer: posts[i - 1], older: posts[i + 1] },
			};
		});
	});
}

const { locale, post, alternate, newer, older } = Astro.props;
const { Content } = await render(post);
const t = ui[locale];
---

<Base
	locale={locale}
	title={post.data.title}
	description={post.data.description}
	alternate={alternate}
	published={post.data.date}
>
	<article>
		<h1 class="post-title">{post.data.title}</h1>
		<p class="post-date">
			<time datetime={post.data.date.toISOString()}>{formatDate(locale, post.data.date)}</time>
			· <a href={localize(locale, `/posts/${post.data.category}`)}>{ui[locale][post.data.category]}</a>
		</p>
		<Content />
	</article>
	{
		(newer || older) && (
			<nav class="post-nav">
				{older && (
					<a href={localize(locale, `/posts/${postSlug(older)}/`)}>
						<span class="dir">← {t.older}</span>
						{older.data.title}
					</a>
				)}
				{newer && (
					<a class="next" href={localize(locale, `/posts/${postSlug(newer)}/`)}>
						<span class="dir">{t.newer} →</span>
						{newer.data.title}
					</a>
				)}
			</nav>
		)
	}
	<Comments locale={locale} />
</Base>
