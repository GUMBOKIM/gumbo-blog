---
import Base from '../../layouts/Base.astro';
import {
	HOME_POST_LIMIT,
	SITE_TITLE,
	getPosts,
	localePaths,
	localize,
	postSlug,
	shortDate,
	toLocale,
	ui,
} from '../../i18n';

export const getStaticPaths = localePaths;

const locale = toLocale(Astro.params.locale);
const t = ui[locale];
const posts = (await getPosts(locale)).slice(0, HOME_POST_LIMIT);
---

<Base locale={locale}>
	<section class="hero">
		<h1>{SITE_TITLE}</h1>
		<p>{t.description}</p>
	</section>

	<section class="recent">
		<h2>{t.recent}</h2>
		<ul>
			{
				posts.map((post) => (
					<li>
						<a href={localize(locale, `/posts/${postSlug(post)}/`)}>
							<span class="meta">
								<time datetime={post.data.date.toISOString()}>
									{post.data.date.getUTCFullYear()}.{shortDate(post.data.date).replace('-', '.')}
								</time>
								<span class="tag">{t[post.data.category]}</span>
							</span>
							<span class="title">{post.data.title}</span>
							{post.data.description && <span class="summary">{post.data.description}</span>}
						</a>
					</li>
				))
			}
		</ul>
		<p class="more"><a href={localize(locale, '/posts')}>{t.allPosts} →</a></p>
	</section>
</Base>
