---
import Base from '../../layouts/Base.astro';
import { Content as AboutKo } from '../../content/about/ko.md';
import { Content as AboutEn } from '../../content/about/en.md';
import { localePaths, toLocale } from '../../i18n';

export const getStaticPaths = localePaths;

const locale = toLocale(Astro.params.locale);
const About = locale === 'ko' ? AboutKo : AboutEn;
---

<Base locale={locale} title="about">
	<h1 class="post-title">about</h1>
	<div class="about">
		<About />
	</div>
</Base>
